# Normalize text files by default
* text=auto

# Keep web/report source files as LF (prevents LF<->CRLF churn on Windows)
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Engineering/code files used in this repo
*.m text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (never line-ending normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.mp4 binary
*.m4v binary
*.mov binary
*.webm binary
*.pdf binary
*.glb binary
*.eprt binary
